---
import Base from '../layouts/Base.astro';
import { data, nameOf, flagOf, pct, dir, video, korDate, embedOn } from '../lib/data';
const by = new Map(data.tickers.map(t => [t.ticker, t]));
const eps = [...data.episodes].sort((a, b) => b.episode - a.episode).map(e => {
  const ts = e.tickers.map(k => by.get(k)!).filter(Boolean).sort((a, b) => b.ret_since_entry - a.ret_since_entry);
  const up = ts.filter(t => t.ret_since_entry > 0).length;
  return { ...e, ts, up, v: video(e.episode) };
});
---
<Base title="회차" active="episodes">
  <section class="top"><h1 class="serif">회차</h1></section>
  {eps.map(e => (
    <section class="ep">
      <div class="eh">
        <div class="et">
          <span class="no serif">{e.episode}회</span>
          <span class="muted">{korDate(e.date)} 종가 기준 편입 · {e.ts.length}종목 · 지금 상승 {e.up} / 하락 {e.ts.length - e.up}</span>
          {e.v && <span class="vt">{e.v.title}</span>}
        </div>
        {e.v && <a class="btn" href={`https://www.youtube.com/watch?v=${e.v.youtube}`} rel="noopener">방송 보기 ↗</a>}
      </div>
      {embedOn && e.v && (
        <div class="lite" data-yt={e.v.youtube}>
          <button type="button" aria-label={`${e.episode}회 방송 재생: ${e.v.title}`}>
            <img src={`https://i.ytimg.com/vi/${e.v.youtube}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360">
            <span class="play" aria-hidden="true"><svg width="68" height="48" viewBox="0 0 68 48"><path d="M66.5 7.7a8.6 8.6 0 0 0-6-6C55.2.3 34 .3 34 .3s-21.2 0-26.5 1.4a8.6 8.6 0 0 0-6 6C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.6 8.6 0 0 0 6 6C12.8 47.7 34 47.7 34 47.7s21.2 0 26.5-1.4a8.6 8.6 0 0 0 6-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3z" fill="#111214" opacity=".85"/><path d="M45 24 27 14v20z" fill="#fff"/></svg></span>
          </button>
        </div>
      )}
      <ul class="tks">
        {e.ts.map(t => <li><a href={`/t/${t.ticker.toLowerCase()}/`}><span class="tk">{t.ticker}</span><span class="nm">{nameOf(t.ticker)}{flagOf(t.ticker) && <span class="flag" title={flagOf(t.ticker)!.reason}> · {flagOf(t.ticker)!.label}</span>}</span><span class={`r ${dir(t.ret_since_entry)}`}>{pct(t.ret_since_entry)}</span></a></li>)}
      </ul>
    </section>
  ))}
</Base>
<script>
  // 누르기 전에는 유튜브를 불러오지 않는다(썸네일만). 누르면 youtube-nocookie 플레이어로 바꾼다.
  document.querySelectorAll<HTMLElement>('.lite').forEach(el => {
    el.querySelector('button')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${el.dataset.yt}?autoplay=1&rel=0`;
      f.title = 'YouTube 동영상';
      f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      f.allowFullscreen = true;
      el.replaceChildren(f);
    }, { once: true });
  });
</script>
<style>
.top{padding-block:40px 20px}
h1{margin:0;font-size:34px;line-height:1.1;letter-spacing:-.4px}
.ep{border-top:1px solid var(--line-strong);padding-block:22px 36px}
.eh{display:flex;justify-content:space-between;align-items:flex-start;gap:24px;flex-wrap:wrap}
.et{display:flex;flex-direction:column;gap:6px;font-size:13px}
.no{font-size:30px;line-height:1}
.vt{font-size:15px;color:var(--ink-2)}
.lite{position:relative;margin-top:18px;max-width:720px;aspect-ratio:16/9;background:var(--paper-3);overflow:hidden}
.lite button{all:unset;cursor:pointer;display:block;width:100%;height:100%;position:relative}
.lite img{width:100%;height:100%;object-fit:cover;display:block}
.lite .play{position:absolute;inset:0;display:flex;align-items:center;justify-content:center}
.lite button:focus-visible{outline:2px solid var(--ink);outline-offset:2px}
.lite iframe{width:100%;height:100%;border:0;display:block}
.btn{font-size:14px;font-weight:600;padding:10px 16px;border:1px solid #d9dbdf;border-radius:999px}
.tks{list-style:none;margin:20px 0 0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));column-gap:40px}
.tks a{display:grid;grid-template-columns:64px minmax(0,1fr) auto;gap:12px;align-items:baseline;padding:12px 0;border-bottom:1px solid var(--line);font-size:15px}
.tk{font-weight:650}.nm{color:var(--ink-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.r{font-weight:600}
.flag{font-size:13px;color:var(--ink-3)}
@media (max-width:960px){.tks{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:600px){.tks{grid-template-columns:1fr}}
</style>
