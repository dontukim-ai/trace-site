---
import Base from '../layouts/Base.astro';
import { data, nameOf, pct, dir, screenLabel, isEnded } from '../lib/data';
const rows = [...data.tickers].sort((a, b) => b.ret_since_entry - a.ret_since_entry);
---
<Base title="변경 기록" description="Tracing 종목별 편입과 주간 스크린 결과의 변화 기록." active="changes">
  <section class="top"><h1 class="serif">변경 기록</h1><span class="muted">종목별, 편입 후 수익률 순</span></section>
  {rows.map(t => (
    <section class="blk">
      <a class="who" href={`/t/${t.ticker.toLowerCase()}/`}><span class="tk">{t.ticker}</span><span class="nm">{nameOf(t.ticker)}</span><span class={`r serif ${dir(t.ret_since_entry)}`}>{pct(t.ret_since_entry)}</span></a>
      <ol class="log">
        {isEnded(t) && t.exit_date && <li><span class="d">{t.exit_date}</span><span>편입 후 {t.days_since_entry}거래일, 기록 종료 · 최종 {pct(t.ret_since_entry)}</span></li>}
        {t.screen && <li><span class="d">{t.screen.asof}</span><span>주간 스크린 {screenLabel(t.screen.result)}{t.screen.result !== '통과' && ` · ${t.screen.stage}`}</span></li>}
        <li><span class="d">{t.entry_date}</span><span>{t.episode}회 방송에서 편입 · 3개월 고점 대비 {pct(t.entry_vs_hi3m)}</span></li>
      </ol>
    </section>
  ))}
</Base>
<style>
.top{display:flex;align-items:baseline;gap:16px;flex-wrap:wrap;padding-block:40px 20px;font-size:13px}
h1{margin:0;font-size:34px;line-height:1.1;letter-spacing:-.4px}
.blk{display:grid;grid-template-columns:320px minmax(0,1fr);gap:24px;border-top:1px solid var(--line);padding:18px 0}
.blk:first-of-type{border-top-color:var(--line-strong)}
.who{display:grid;grid-template-columns:64px minmax(0,1fr) auto;gap:12px;align-items:baseline}
.tk{font-size:17px;font-weight:650}.nm{color:var(--ink-2);font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.r{font-size:22px}
.log{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px;font-size:14px}
.log li{display:grid;grid-template-columns:110px minmax(0,1fr);gap:8px}
.d{color:var(--ink-3)}
@media (max-width:760px){.blk{grid-template-columns:1fr;gap:10px}}
</style>
