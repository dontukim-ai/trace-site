---
import Base from '../layouts/Base.astro';
import StockRow from '../components/StockRow.astro';
import { data } from '../lib/data';
const rows = [...data.tickers].sort((a, b) => b.ret_since_entry - a.ret_since_entry);
const eps = data.episodes.map(e => e.episode);
---
<Base active="tracing">
  <section class="top">
    <div class="ttl"><h1 class="serif">Tracing</h1><span class="serif cnt" id="cnt">{rows.length}</span></div>
    <div class="ctl">
      <div class="pills" role="group" aria-label="회차">
        <button type="button" aria-pressed="true" data-ep="all">전체</button>
        {eps.map(e => <button type="button" aria-pressed="false" data-ep={e}>{e}회</button>)}
      </div>
      <span class="muted sort">편입 후 수익률 순</span>
    </div>
  </section>
  <div class="head" aria-hidden="true">
    <span></span><span>종목</span><span>편입 후</span><span>편입 전 65일 · 이후 · Kronos 20거래일</span><span class="r">3개월 고점 대비</span>
  </div>
  <div id="list">
    {rows.map((t, i) => <StockRow t={t} rank={i + 1} />)}
  </div>
  <ul class="legend">
    <li><svg width="22" height="8" aria-hidden="true"><line x1="0" x2="22" y1="4" y2="4" stroke="var(--chart-pre)" stroke-width="1.5"/></svg>편입 전</li>
    <li><svg width="22" height="8" aria-hidden="true"><line x1="0" x2="22" y1="4" y2="4" stroke="var(--ink)" stroke-width="1.75"/></svg>편입 후 (편입일 = 100)</li>
    <li><svg width="22" height="12" aria-hidden="true"><rect width="22" height="12" fill="var(--band-inner)"/></svg>Kronos 20거래일 경로 분포 (확률 구간 아님)</li>
    <li><svg width="10" height="14" aria-hidden="true"><line x1="5" x2="5" y1="1" y2="13" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round"/></svg>lookback 30·60·90일 중앙값 범위</li>
  </ul>
</Base>
<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.pills button');
  const rows = document.querySelectorAll<HTMLElement>('#list .row');
  const cnt = document.getElementById('cnt')!;
  btns.forEach(b => b.addEventListener('click', () => {
    btns.forEach(o => o.setAttribute('aria-pressed', String(o === b)));
    const ep = b.dataset.ep;
    let n = 0, r = 0;
    rows.forEach(row => {
      const show = ep === 'all' || row.dataset.ep === ep;
      row.hidden = !show;
      if (show) { n++; r++; const k = row.querySelector('.rank'); if (k) k.textContent = String(r).padStart(2, '0'); }
    });
    cnt.textContent = String(n);
  }));
</script>
<style>
.top{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap;padding-block:40px 20px}
.ttl{display:flex;align-items:baseline;gap:12px}
h1{margin:0;font-size:40px;line-height:1;letter-spacing:-.5px}
.cnt{font-size:22px;color:var(--ink-5)}
.ctl{display:flex;align-items:center;gap:24px;font-size:13px;flex-wrap:wrap}
.pills{display:flex;gap:4px}
.pills button{font:inherit;border:0;background:transparent;color:var(--ink-2);padding:8px 14px;border-radius:999px;cursor:pointer;min-height:36px}
.pills button:hover{background:var(--paper-3)}
.pills button[aria-pressed=true]{background:var(--ink);color:var(--paper)}
.head{display:grid;grid-template-columns:36px 220px 110px minmax(0,1fr) 170px;gap:24px;padding-bottom:10px;border-bottom:1px solid var(--line-strong);font-size:11px;letter-spacing:.4px;color:var(--ink-3)}
.head .r{text-align:right}
.legend{list-style:none;margin:0;padding:28px 0 0;display:flex;flex-wrap:wrap;gap:12px 28px;font-size:12px;color:var(--ink-3)}
.legend li{display:flex;align-items:center;gap:8px}
@media (max-width:980px){.head{display:block;padding:0;height:0;overflow:hidden}}
@media (max-width:760px){
  .top{padding-block:24px 12px}
  h1{font-size:34px}.cnt{font-size:20px}
  .pills button{min-height:44px;padding:8px 12px}
  .legend{font-size:11px}
}
</style>
