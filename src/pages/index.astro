---
import Base from '../layouts/Base.astro';
import StockRow from '../components/StockRow.astro';
import { data } from '../lib/data';
const rows = [...data.tickers].sort((a, b) => b.ret_since_entry - a.ret_since_entry);
const eps = data.episodes.map(e => e.episode).sort((a, b) => b - a);
// 버튼은 최근 4회까지, 그 이전 회차는 '이전 회차' 선택 상자로 (5회차부터 생김)
const RECENT = 4;
const recent = eps.slice(0, RECENT), older = eps.slice(RECENT);
---
<Base active="tracing">
  <section class="top">
    <div class="ttl">
      <h1 class="serif">Tracing</h1><span class="serif cnt" id="cnt">{rows.length}</span><span class="unit">종목</span>
      <span class="sort">편입 후 수익률 순</span>
    </div>
    <div class="ctl" role="group" aria-label="회차">
      <div class="pills">
        <button type="button" aria-pressed="true" data-ep="all">전체</button>
        {recent.map(e => <button type="button" aria-pressed="false" data-ep={e}>{e}회</button>)}
      </div>
      {older.length > 0 && (
        <label class="older"><span class="sr">이전 회차</span>
          <select id="older">
            <option value="">이전 회차</option>
            {older.map(e => <option value={e}>{e}회</option>)}
          </select>
        </label>
      )}
    </div>
  </section>
  <div class="head" aria-hidden="true">
    <span></span><span>종목</span><span>편입 후</span><span>편입 전 65일 · 이후 · Kronos 20거래일</span><span class="r">3개월 고점 대비</span>
  </div>
  <div id="list">
    {rows.map((t, i) => <StockRow t={t} rank={i + 1} />)}
  </div>
  <ul class="legend">
    <li><svg width="22" height="8" aria-hidden="true"><line x1="0" x2="22" y1="4" y2="4" stroke="var(--chart-pre)" stroke-width="1.5"/></svg>편입 전</li>
    <li><svg width="22" height="8" aria-hidden="true"><line x1="0" x2="11" y1="4" y2="4" stroke="var(--up)" stroke-width="1.75"/><line x1="11" x2="22" y1="4" y2="4" stroke="var(--down)" stroke-width="1.75"/></svg>편입 후 (편입일 = 100, 위 빨강 · 아래 파랑)</li>
    <li><svg width="22" height="12" aria-hidden="true"><rect width="22" height="12" fill="var(--band-inner)"/></svg>Kronos 20거래일 경로 분포 (확률 구간 아님) · 기간별 차이는 종목 상세에서</li>
  </ul>
</Base>
<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.pills button');
  const sel = document.getElementById('older') as HTMLSelectElement | null;
  const rows = document.querySelectorAll<HTMLElement>('#list .row');
  const cnt = document.getElementById('cnt')!;
  const show = (ep: string) => {
    btns.forEach(o => o.setAttribute('aria-pressed', String(o.dataset.ep === ep)));
    if (sel) { sel.value = [...sel.options].some(o => o.value === ep) ? ep : ''; sel.classList.toggle('on', sel.value !== ''); }
    let n = 0;
    rows.forEach(row => {
      const on = ep === 'all' || row.dataset.ep === ep;
      row.hidden = !on;
      if (on) { n++; const k = row.querySelector('.rank'); if (k) k.textContent = String(n).padStart(2, '0'); }
    });
    cnt.textContent = String(n);
  };
  btns.forEach(b => b.addEventListener('click', () => show(b.dataset.ep!)));
  sel?.addEventListener('change', () => show(sel.value || 'all'));
</script>
<style>
.top{display:flex;align-items:flex-end;justify-content:space-between;gap:16px 24px;flex-wrap:wrap;padding-block:40px 20px}
.ttl{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}
h1{margin:0;font-size:28px;line-height:1;letter-spacing:-.3px}
.cnt{font-size:28px;line-height:1;color:var(--ink-3)}
.unit{font-size:14px;color:var(--ink-3)}
.sort{font-size:13px;color:var(--ink-3);margin-left:16px;padding-left:16px;border-left:1px solid var(--line)}
.ctl{display:flex;align-items:center;gap:8px;font-size:13px;min-width:0;max-width:100%}
.pills{display:flex;gap:4px;overflow-x:auto;scrollbar-width:none}
.pills::-webkit-scrollbar{display:none}
.pills button{font:inherit;border:0;background:transparent;color:var(--ink-2);padding:8px 14px;border-radius:999px;cursor:pointer;min-height:36px;white-space:nowrap}
.pills button:hover{background:var(--paper-3)}
.pills button[aria-pressed=true]{background:var(--ink);color:var(--paper)}
.older select{font:inherit;color:var(--ink-2);background:transparent;border:1px solid var(--line-strong);border-radius:999px;padding:7px 28px 7px 14px;min-height:36px;cursor:pointer;appearance:none;background-image:linear-gradient(45deg,transparent 50%,currentColor 50%),linear-gradient(135deg,currentColor 50%,transparent 50%);background-position:calc(100% - 15px) 52%,calc(100% - 10px) 52%;background-size:5px 5px;background-repeat:no-repeat}
.older select.on{background-color:var(--ink);color:var(--paper);border-color:var(--ink)}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.head{display:grid;grid-template-columns:36px 220px 110px minmax(0,1fr) 170px;gap:24px;padding-bottom:10px;border-bottom:1px solid var(--line-strong);font-size:11px;letter-spacing:.4px;color:var(--ink-3)}
.head .r{text-align:right}
.legend{list-style:none;margin:0;padding:28px 0 0;display:flex;flex-wrap:wrap;gap:12px 28px;font-size:12px;color:var(--ink-3)}
.legend li{display:flex;align-items:center;gap:8px}
@media (max-width:980px){.head{display:block;padding:0;height:0;overflow:hidden}}
@media (max-width:760px){
  .top{padding-block:24px 12px}
  h1{font-size:24px}.cnt{font-size:24px}.sort{margin-left:8px;padding-left:10px}
  .pills button,.older select{min-height:44px}
  .legend{font-size:11px}
}
</style>
