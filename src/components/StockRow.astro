---
import TraceChart from './TraceChart.astro';
import { type Ticker, nameOf, flagOf, pct, dir, mmdd, isEnded, appearancesOf } from '../lib/data';
interface Props { t: Ticker; rank: number }
const { t, rank } = Astro.props;
const ended = isEnded(t) && t.exit_date;
const flag = flagOf(t.ticker);
// 편입일부터 마지막 기록일(종료 종목은 종료일)까지 달력일 수
// 이 종목이 방송 통과 목록에 나온 회차 전부 (편입 회차 + 재통과 회차). 회차 필터에 쓴다
const eps = appearancesOf(t).join(' ');
const days = Math.round((Date.parse(t.series[t.series.length - 1][0]) - Date.parse(t.entry_date)) / 864e5);
---
<a class="row" href={`/t/${t.ticker.toLowerCase()}/`} data-ep={t.episode} data-eps={eps}>
  <span class="rank serif">{String(rank).padStart(2, '0')}</span>
  <span class="who">
    <span class="tk">{t.ticker}</span>
    <span class="nm">{nameOf(t.ticker)}</span>
    <span class="meta">{t.episode}회 · {mmdd(t.entry_date)} 편입{ended && ` · ${mmdd(ended)} 종료`}<span class="re" hidden> · 재통과</span>{flag && <span class="flag" title={flag.reason}> · {flag.label}</span>}</span>
  </span>
  <span class={`ret serif ${dir(t.ret_since_entry)}`}>{pct(t.ret_since_entry)}</span>
  <span class="chart"><TraceChart t={t} /></span>
  <span class="dd">
    <span>편입 시 <b class={dir(t.entry_vs_hi3m)}>{pct(t.entry_vs_hi3m)}</b></span>
    <span>편입 후 +{days}일 <b class={dir(t.now_vs_hi3m)}>{pct(t.now_vs_hi3m)}</b></span>
  </span>
</a>
<style>
.row{display:grid;grid-template-columns:36px 220px 110px minmax(0,1fr) 170px;gap:24px;align-items:center;padding:22px 0;border-bottom:1px solid var(--line)}
.row[hidden]{display:none}
.row:hover{color:inherit}.row:hover .tk{text-decoration:underline;text-underline-offset:3px}
.rank{font-size:16px;color:var(--ink-5)}
.who{display:flex;flex-direction:column;gap:4px;min-width:0}
.tk{font-size:20px;font-weight:650;letter-spacing:.2px}
.nm{font-size:15px;color:var(--ink-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.meta{font-size:13px;color:var(--ink-3)}
.flag{color:var(--ink-2);font-weight:600}
.re{color:var(--ink-2);font-weight:600}
.re[hidden]{display:none}
.ret{font-size:26px;line-height:1;letter-spacing:-.3px}
.chart{min-width:0;display:block}
.dd{display:flex;flex-direction:column;gap:8px;align-items:flex-end;font-size:15px;color:var(--ink-3)}
.dd b{font-size:17px;font-weight:600}
@media (max-width:980px){
  .row{grid-template-columns:minmax(0,1fr) auto;grid-template-areas:"who ret" "chart chart" "dd dd";gap:10px 12px;padding:18px 0 16px}
  .rank{display:none}
  .who{grid-area:who}.ret{grid-area:ret;font-size:24px}.chart{grid-area:chart}
  .chart :global(svg){height:64px}
  .tk{font-size:18px}.nm{font-size:14px}.meta{font-size:12px}
  .dd{grid-area:dd;flex-direction:row;gap:16px;align-items:center;font-size:13px}.dd b{font-size:13px}
}
</style>
